# Copy this file to .env and fill in the real values.
# .env is gitignored - never commit it.

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (Atlas > Connect > Drivers > Node.js).
# Remember to replace <db_password> with the real password.
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Which database inside the cluster to use. Set here rather than in the URI so
# the connection string can be pasted from Atlas unmodified.
MONGO_DB_NAME=incident-assistant

# Voyage AI key, used to create embeddings for runbook retrieval (RAG).
# Get one at https://dashboard.voyageai.com > API keys.
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxx
