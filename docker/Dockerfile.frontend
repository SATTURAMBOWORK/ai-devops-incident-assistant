# Build from the repo root, like the other images:
#   docker build -f docker/Dockerfile.frontend -t incident-frontend .

# ---- Stage 1: build the static site -----------------------------------------
# Node is only needed to RUN Vite. The output is plain HTML, CSS and JS, so
# nothing from this stage except dist/ ends up in the final image.
FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# Vite bakes env vars into the JS at BUILD time - setting it when the container
# starts would do nothing. Empty (the default) means "same origin": nginx below
# proxies /api, so the browser never needs to know where the backend lives.
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# ---- Stage 2: serve it ------------------------------------------------------
# nginx serves static files far more efficiently than a Node process would, and
# the final image has no Node, no node_modules and no source code - ~50MB
# instead of ~400MB, with much less to patch.
FROM nginx:stable-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
# The base image's CMD already runs nginx in the foreground.
